 use crate::{Player, Sim};
+
+// A placement sweep only borrows Sim. Its third and later radius queries
+// can walk compact bodies instead of repeatedly touching the large Unit records.
+// Nothing survives the sweep, so moves, deaths, owners, types and orders are
+// always observed afresh by the next sweep. The first two queries allocate nothing.
+pub(crate) struct RadiusScan<'a> {
+    sim: &'a Sim,
+    positions: Option<(Option<usize>, i32, Vec<RadiusBody>)>,
+    ordered: Option<(Player, Option<usize>, i32, Vec<RadiusBody>)>,
+    bounds: Option<(Pos, Pos)>,
+    position_calls: u8,
+    ordered_calls: u8,
+}
+struct RadiusBody {
+    at: Pos,
+    radius: i32,
+}
+
+// vector_dist is at least the larger absolute component in this nonoverflowing
+// range. Outside it retain its original arithmetic, including its unusual large
+// coordinate behavior. The exact distance still decides every surviving body.
+fn radius_may_reach(bounds: Option<(Pos, Pos)>, body: &RadiusBody, radius: i32) -> bool {
+    let Some((low, high)) = bounds else {
+        return true;
+    };
+    let Some(sum) = body.radius.checked_add(radius) else {
+        return true;
+    };
+    if sum < 0 {
+        return true;
+    }
+    let axis = |value: i32, lo: i32, hi: i32| {
+        let left = i64::from(lo) - i64::from(value);
+        let right = i64::from(hi) - i64::from(value);
+        (left.abs().max(right.abs()), left.max(0).max(-right))
+    };
+    let (xmax, xmin) = axis(body.at.x, low.x, high.x);
+    let (ymax, ymin) = axis(body.at.y, low.y, high.y);
+    // Do not elide the original arithmetic outside the proven distance range.
+    if xmax.max(ymax) > i64::from(i32::MAX / 2) {
+        return true;
+    }
+    xmin.max(ymin) <= i64::from(sum)
+}
+
+fn radius_contains(at: Pos, body: Pos, radius: i32) -> bool {
+    let dx = at.x - body.x;
+    let dy = at.y - body.y;
+    let hi = dx.unsigned_abs().max(dy.unsigned_abs());
+    if hi <= (i32::MAX / 2) as u32 && radius >= 0 && hi > radius as u32 {
+        return false;
+    }
+    vector_dist(dx, dy) <= radius
+}
+
+impl<'a> RadiusScan<'a> {
+    pub(crate) fn new(sim: &'a Sim, centre: Pos, extent: i32) -> Self {
+        let bounds = (|| {
+            let extent = extent.checked_abs()?;
+            Some((
+                Pos::new(centre.x.checked_sub(extent)?, centre.y.checked_sub(extent)?),
+                Pos::new(centre.x.checked_add(extent)?, centre.y.checked_add(extent)?),
+            ))
+        })();
+        Self {
+            sim,
+            bounds,
+            positions: None,
+            ordered: None,
+            position_calls: 0,
+            ordered_calls: 0,
+        }
+    }
+    fn outside_bounds(&self, at: Pos) -> bool {
+        self.bounds
+            .is_some_and(|(lo, hi)| at.x < lo.x || at.x > hi.x || at.y < lo.y || at.y > hi.y)
+    }
+    pub(crate) fn position(&mut self, radius: i32, at: Pos, exempt: Option<usize>) -> bool {
+        if self.outside_bounds(at) {
+            return self.sim.find_unit_with_radius(radius, at, exempt);
+        }
+        if self.position_calls < 2 {
+            self.position_calls += 1;
+            return self.sim.find_unit_with_radius(radius, at, exempt);
+        }
+        if self
+            .positions
+            .as_ref()
+            .is_none_or(|(key, r, _)| *key != exempt || *r != radius)
+        {
+            let bodies = self
+                .sim
+                .units
+                .iter()
+                .enumerate()
+                .filter(|(unit, u)| Some(*unit) != exempt && u.owner < 8 && u.alive() && u.on_map)
+                .map(|(unit, u)| RadiusBody {
+                    at: u.pos,
+                    radius: self.sim.profile(Obj::Unit(unit)).big_radius,
+                })
+                .filter(|body| radius_may_reach(self.bounds, body, radius))
+                .collect();
+            self.positions = Some((exempt, radius, bodies));
+        }
+        self.positions
+            .as_ref()
+            .unwrap()
+            .2
+            .iter()
+            .any(|b| radius_contains(at, b.at, b.radius + radius))
+    }
+    pub(crate) fn ordered(
+        &mut self,
+        radius: i32,
+        at: Pos,
+        owner: Player,
+        exempt: Option<usize>,
+    ) -> bool {
+        if self.outside_bounds(at) {
+            return self
+                .sim
+                .find_unit_ordered_with_radius(radius, at, owner, exempt);
+        }
+        if self.ordered_calls < 2 {
+            self.ordered_calls += 1;
+            return self
+                .sim
+                .find_unit_ordered_with_radius(radius, at, owner, exempt);
+        }
+        if self
+            .ordered
+            .as_ref()
+            .is_none_or(|(who, key, r, _)| *who != owner || *key != exempt || *r != radius)
+        {
+            let bodies = self
+                .sim
+                .units
+                .iter()
+                .enumerate()
+                .filter(|(unit, u)| {
+                    Some(*unit) != exempt
+                        && u.owner == owner
+                        && u.alive()
+                        && self
+                            .sim
+                            .current_order(*unit)
+                            .is_some_and(|od| index::is_move_family(od.index()))
+                })
+                .map(|(unit, u)| RadiusBody {
+                    at: u.orders_pos,
+                    radius: self.sim.profile(Obj::Unit(unit)).big_radius,
+                })
+                .filter(|body| radius_may_reach(self.bounds, body, radius))
+                .collect();
+            self.ordered = Some((owner, exempt, radius, bodies));
+        }
+        // Unlike position queries, orders include off-map units and any owner.
+        self.ordered
+            .as_ref()
+            .unwrap()
+            .3
+            .iter()
+            .any(|b| radius_contains(at, b.at, b.radius + radius))
+    }
+}
 
