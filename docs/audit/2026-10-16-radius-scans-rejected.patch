+    #[test]
+    fn radius_bounds_fallback_and_radius_key_preserve_live_answers() {
+        let (sim, _, _) = pair(Pos::new(3000, 3000), Pos::new(9000, 9000));
+        let mut scan = RadiusScan::new(&sim, Pos::new(5000, 5000), 100);
+        for _ in 0..3 {
+            assert!(!scan.position(0, Pos::new(5000, 5000), None));
+        }
+        assert!(scan.positions.as_ref().unwrap().2.is_empty());
+        // A larger radius must rebuild the empty candidate set.
+        assert_eq!(
+            scan.position(5000, Pos::new(5000, 5000), None),
+            sim.find_unit_with_radius(5000, Pos::new(5000, 5000), None)
+        );
+        assert!(!scan.positions.as_ref().unwrap().2.is_empty());
+        // Even an excluded body is found by an out-of-bounds query.
+        assert!(scan.position(0, Pos::new(9000, 9000), None));
+        assert!(
+            RadiusScan::new(&sim, Pos::new(i32::MAX, 0), 100)
+                .bounds
+                .is_none()
+        );
+        assert!(
+            RadiusScan::new(&sim, Pos::new(0, 0), i32::MIN)
+                .bounds
+                .is_none()
+        );
+    }
