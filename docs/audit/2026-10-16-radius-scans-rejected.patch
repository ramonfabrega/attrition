+    #[test]
+    fn scoped_radius_queries_match_live_scans_after_mutations() {
+        let (mut sim, _, _) = pair(Pos::new(3000, 3000), Pos::new(3100, 3100));
+        for i in 2..32 {
+            let mut u = Unit::new(
+                (i % 2) as u8,
+                i as i16,
+                Pos::new(3000 + i * 23, 3000 - i * 19),
+                40,
+            );
+            u.ty = (i % 3 != 0).then_some(0);
+            sim.add_unit(u);
+        }
+        for i in 0..sim.units.len() {
+            sim.order_move(i, Pos::new(3200 + i as i32 * 11, 3000));
+            if i % 3 == 0 {
+                sim.units[i].orders.clear();
+            } else if i % 3 == 1 {
+                sim.units[i].orders.front_mut().unwrap().body = Body::Think;
+            }
+        }
+        let walking = *sim.units[2].orders.front().unwrap();
+        for phase in 0..5 {
+            for (i, u) in sim.units.iter_mut().enumerate() {
+                u.owner = ((i + phase) % 10) as u8;
+                u.on_map = (i + phase) % 3 != 0;
+                u.health = if (i + phase) % 5 == 0 { 0 } else { 40 };
+                u.pos.x += phase as i32 * 17;
+                u.orders_pos.y -= phase as i32 * 31;
+                u.orders.clear();
+                if (i + phase) % 3 != 0 {
+                    let mut order = walking;
+                    if (i + phase) % 3 == 1 {
+                        order.body = Body::Think;
+                    }
+                    u.orders.push_back(order);
+                }
+                if phase == 3 {
+                    u.ty = None;
+                }
+                if phase == 4 {
+                    u.ty = Some(0);
+                }
