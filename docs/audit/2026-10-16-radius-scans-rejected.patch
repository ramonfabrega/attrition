+                for y in [-40, 0, 40, 60, 60_000, 1_500_000_000] {
+                    for r in [-1, 0, 1, 20, 100, i32::MAX] {
+                        let body = RadiusBody {
+                            at: Pos::new(x, y),
+                            radius: 0,
+                        };
+                        if !radius_may_reach(Some((lo, hi)), &body, r) {
+                            for qx in lo.x..=hi.x {
+                                for qy in lo.y..=hi.y {
+                                    assert!(!radius_contains(Pos::new(qx, qy), body.at, r));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        let body = RadiusBody {
+            at: Pos::new(1000, 1000),
+            radius: i32::MAX,
+        };
+        assert!(radius_may_reach(
+            Some((Pos::new(0, 0), Pos::new(1, 1))),
+            &body,
+            1
+        ));
+        assert!(radius_may_reach(None, &body, 0));
+    }
